+    def cmd_FILAMENT_DT_SET(self, gcmd):
+        channel = gcmd.get_int('CHANNEL', None)
+
+        if (channel is None):
+            raise gcmd.error("CHANNEL must be specified!")
+
+        if (channel < 0 or channel >= self._channel_nums):
+            msg = ("channel[%d] is out of range[0, %d]" % (channel, self._channel_nums - 1))
+            raise gcmd.error(msg)
+
+        params = dict(gcmd.get_command_parameters())
+        params.pop('CHANNEL', None)
+
+        filament_info = copy.deepcopy(filament_protocol.FILAMENT_INFO_STRUCT)
+
+        if 'VENDOR' in params:
+            filament_info['VENDOR'] = str(params.pop('VENDOR'))
+        if 'TYPE' in params:
+            filament_info['MAIN_TYPE'] = str(params.pop('TYPE'))
+        if 'SUBTYPE' in params:
+            filament_info['SUB_TYPE'] = str(params.pop('SUBTYPE'))
+
+        if 'MIN_TEMP' in params:
+            filament_info['HOTEND_MIN_TEMP'] = int(params.pop('MIN_TEMP'))
+        if 'MAX_TEMP' in params:
+            filament_info['HOTEND_MAX_TEMP'] = int(params.pop('MAX_TEMP'))
+        if 'BED_TEMP' in params:
+            filament_info['BED_TEMP'] = int(params.pop('BED_TEMP'))
+
+        if 'ALPHA' in params:
+            alpha = str(params.pop('ALPHA')).strip()
+            filament_info['ALPHA'] = int(alpha, 16) & 0xFF
+        if 'COLOR' in params:
+            color = str(params.pop('COLOR')).strip()
+            filament_info['RGB_1'] = int(color, 16) & 0xFFFFFF
+        filament_info['ARGB_COLOR'] = filament_info['ALPHA'] << 24 | filament_info['RGB_1']
+
+        if 'CARD_UID' in params:
+            filament_info['CARD_UID'] = list(bytes.fromhex(str(params.pop('CARD_UID'))))
+
+        if params:
+            raise gcmd.error("unsupported fields: %s" % (', '.join(sorted(params.keys()))))
+
+        self._state[channel] = FILAMENT_DT_STATE_IDLE
+        self._filament_info_update(channel, filament_info, True)
+
